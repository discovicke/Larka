<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Backend</RootNamespace>
    <UserSecretsId>net25-devops-grupp-4-backend</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <ClientRoot>$(MSBuildProjectDirectory)/../client/</ClientRoot>
  </PropertyGroup>

  <!--
    Skriver OpenAPI-dokumentet till client/openapi.json vid varje Debug-build. Klienten genererar sina
    typer från filen (npm run gen:api). Release (dotnet publish i Dockerfile) hoppar över det.
  -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiGenerateDocuments Condition="'$(Configuration)' == 'Debug'">true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(ClientRoot)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <!-- Bygger klienten vid dotnet publish och lägger den i wwwroot. Vanlig build/test behöver inte Node. -->
  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm run build" />

    <ItemGroup>
      <ClientDistFiles Include="$(ClientRoot)dist/**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
