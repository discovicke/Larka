# Det en installation av Lärka ställer in. Allt annat har standardvärden i backend/appsettings.json
# (docs/konfiguration.md).
#
# Egen server: kopiera filen till deploy/.env (checkas aldrig in) och fyll i. compose.yaml läser den.
# Molnet: lägg samma nycklar i värdtjänstens inställningar (App Service, Render, ...).
# Vår prod: samma nycklar ligger i Infisical (docs/deploy.md).
#
# Nycklarna är appens egna: Auth__Jwt__Key är Auth:Jwt:Key. Versaler spelar ingen roll.

# --- Bara för deploy/compose.yaml ---------------------------------------------------------------------------------
# Adressen till Lärka. Caddy hämtar ett certifikat för den, så DNS ska peka på servern.
LARKA_DOMAIN=larka.skolan.se
# Imagens version. Lås den, och uppgradera genom att byta den (docs/drift.md).
LARKA_VERSION=v1.70.1
# Lösenordet till databasen i compose. Långt och slumpat: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Krävs ---------------------------------------------------------------------------------------------------------
# Postgres i .NET-format. compose.yaml sätter den själv från POSTGRES_PASSWORD.
# ConnectionStrings__Default=Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require
# Minst 32 byte: openssl rand -base64 48. Byts den loggas alla ut.
Auth__Jwt__Key=

# --- Filer: disk eller Supabase Storage ----------------------------------------------------------------------------
# compose.yaml sparar filerna på disk (Storage__Disk__Path=/data/files). Supabase används i stället om båda sätts:
# Storage__Supabase__Url=https://<projekt>.supabase.co
# Storage__Supabase__ServiceRoleKey=

# --- Microsoft-inloggning. infra/entra-setup.sh skriver ut raderna -------------------------------------------------
Auth__Entra__ClientId=
Auth__Entra__TenantId=
Auth__Entra__AdminObjectId=
Auth__Entra__SchoolName=

# --- Valfritt ------------------------------------------------------------------------------------------------------
# Demokonton (admin/admin m.fl.) och Edugrades demodata. Bara för en demo, aldrig för en riktig skola.
# Database__SeedDemoData=true
# GitHub-integrationen: nycklarna under GitHub__ i docs/konfiguration.md.
